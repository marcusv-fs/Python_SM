interface IPlatOps {
	armUAV ( )
	takeOff ( )
tryToConnect ( )
backHome ( )
relMove ( pos : Position )
land ( )

	setMode ( mode : string )
relTakeOff ( tgHeight : real , homePos : real )
}

interface IEvents {
	event start : int

	event takePicture : Image
}

interface IPhases {
	Phase1 ( homePos: Position, TARGET_HEIGHT: real )
	Phase2 ( )
	Phase3 ( homePos : Position , TARGET_HEIGHT : real )
	Phase4 ( homePos : Position , TARGET_HEIGHT : real )
}

interface IFrontCamera {
	event takeFrontPic : Image
}

robotic platform UAV {
	uses IEvents provides IPlatOps }

datatype Position {   X : real Y : real Z : real } datatype Target { pos : Position id : int visited : boolean } datatype Image { RGB : string } 

stm FRTL {
	uses IEvents requires IPlatOps 
	
	
	var isConnected : boolean = false , phase : int , connectionTrys : int = 0 , homePos : Position
	requires IPhases initial i0
	final f0
	state Connect {
		entry isConnected = tryToConnect ( ) ; connectionTrys = connectionTrys + 1
	}
	state Wait {
		entry homePos = setHome ( )
	}
	state StartEngines {
		entry setMode ( "GUIDED" ) ; wait ( 1 ) ; armUAV ( ) ; wait ( 1 )
	}
	state TakeOff {
		entry relTakeOff ( TARGET_HEIGHT , homePos . Z ) ; wait ( 1 )
	}
	state Phases {
	entry if phase == 1 then Phase1 ( homePos , TARGET_HEIGHT ) else if phase == 2 then Phase2 ( ) else if phase == 3 then Phase3 ( ) else if phase == 4 then Phase4 ( ) end end end end
	}
	transition t0 {
		from i0
		to Connect
	}
	transition t1 {
		from Connect
		to Wait
	condition isConnected == true
	}
	transition t2 {
		from Wait
		to StartEngines
	trigger 	
	
	start ? phase
	}
	transition t3 {
		from StartEngines
		to TakeOff
	}
	transition t5 {
		from Phases
		to f0
	action backHome ( )
	}
const TARGET_HEIGHT : real = 4
transition t6 {
		from Connect
		to f0
		condition connectionTrys >= 3 /\ not isConnected == true
	}
	transition t7 {
		from Connect
		to Connect
		condition not isConnected == true /\ connectionTrys < 3
	}
	transition t4 {
		from TakeOff
		to Phases
	}
}

operation Phase1 ( homePos: Position, TARGET_HEIGHT: real) {
requires IPlatOps uses IEvents const qtdPos : int = 5 , SAFE_DISTANCE : real = 0.5 , DSD_LAND_ALT : real = - 0.5 , SMOOTH : real = 0.4
	initial i0
var count : int = 0 , img : Image , visitedBases : int = 0 , bases : vector ( Target , 6 ) , defPos : vector ( Position , 3 ) , basePos : Position , dronePos : Position , distToTarget : real
	state Explore {
	}
	state SearchForBases {
		entry bases = SearchBases ( img )
	}
	transition t0 {
		from i0 
		to Explore
		action 
	count = 0 ; visitedBases = 0
	}
	transition t1 {
		from Explore
		to SearchForBases
		trigger 
		
		
		
		
		
		
		
		takePicture ? img
		condition count < qtdPos
	}
	transition t2 {
		from SearchForBases
		to Explore
	condition len ( bases ) <= 0
		action count = count + 1
	}
	state GoToBase {
		entry basePos = bases [ visitedBases ] . pos ; relMove ( basePos ) ; wait ( 1 )
	}
	transition t3 {
		from SearchForBases
		to GoToBase
		condition count >= qtdPos
		action 
	
	count = 1 ; bases = optimizeBasePositions ( )
	}
state ApproachToBase {
		entry takePicture ? img ; dronePos = updateDronePos ( ) ; basePos = SearchNearestBase ( img ) ; distToTarget = calcDist ( basePos , dronePos )
	}
state LandAndScore {
		entry land ( ) ; wait ( 1 ) ; bases = markVisitedBase ( dronePos , bases ) ; visitedBases = visitedBases + 1
	}
	final f0
	transition t4 {
		from GoToBase
		to ApproachToBase
	}
	transition t5 {
		from ApproachToBase
		to ApproachToBase
		condition 
		
		not isSafeToLand ( )
		action delta_z = ( DSD_LAND_ALT - dronePos . Z ) * SMOOTH ; relMove ( basePos . X , basePos . Y , - delta_z )
	}
	transition t6 {
		from ApproachToBase
		to LandAndScore
		condition isSafeToLand ( )
	}
	transition t7 {
		from LandAndScore
		to TakeOff
		}
	transition t8 {
		from TakeOff
		to f0
		condition visitedBases >= len ( bases )
	}
	transition t10 {
		from TakeOff
		to GoToBase
		condition visitedBases < len ( bases )
	}
var delta_z : real
state TakeOff {
		entry setMode ( "GUIDED" ) ; armUAV ( ) ; relTakeOff ( TARGET_HEIGHT , homePos . Z ) ; wait ( 1 )
	}
}

operation Phase4 ( homePos : Position
, TARGET_HEIGHT : real
) {
	uses IEvents requires IPlatOps const qtdPos : int = 3
	var img : Image , targetPos : Position , dronePos : Position , distToTarget : real , SAFE_DISTANCE : real = 1
	initial i0
	state GoToCenter {
		entry takePicture ? img ; targetPos = SearchNearestBase ( img )
	}
	state StartLanding {
		entry relMove ( targetPos ) ; wait ( 1 ) ; SAFE_DISTANCE = 0.3 ; takePicture ? img ; targetPos = SearchNearestBase ( img )
	}
	state AbortLanding {
		entry targetPos . X = 4 ; targetPos . Y = 4 ; targetPos . Z = 1 ; SAFE_DISTANCE = 1
	}
	state FinishLanding {
		entry land ( ) ; wait ( 1 ) ; setMode ( "GUIDED" )
	}
	final f0
	state TakeOff {
		entry armUAV ( ) ; relTakeOff ( TARGET_HEIGHT , homePos . Z ) ; wait ( 1 )
	}
	transition t0 {
		from i0
		to GoToCenter
		action targetPos . X = 4 ; targetPos . Y = 4 ; targetPos . Z = 1 ; relMove ( targetPos )
	}
	transition t1 {
		from GoToCenter
		to StartLanding
		condition targetPos . X < SAFE_DISTANCE /\ targetPos . Y < SAFE_DISTANCE
	}
	transition t2 {
		from StartLanding
		to AbortLanding
		condition targetPos . X > SAFE_DISTANCE \/ targetPos . Y > SAFE_DISTANCE
	}
	transition t3 {
		from AbortLanding
		to GoToCenter
		action relMove ( targetPos ) ; wait ( 1 )
	}
	transition t4 {
		from StartLanding
		to FinishLanding
		condition targetPos . X < SAFE_DISTANCE /\ targetPos . Y < SAFE_DISTANCE
	}
	transition t5 {
		from FinishLanding
		to TakeOff
	}
	transition t6 {
		from TakeOff
		to f0
	}
}

operation Phase3 ( homePos : Position
, TARGET_HEIGHT : real
) {
	requires IPlatOps const qtdPos : int = 3 , SAFE_DISTANCE : real = 0.5 , SHELF_POS : Position
	var Score : int , checkpoints : vector ( Position , 8 ) , count : int = 0 , reading : boolean = false
	initial i0
	state GoToShelf {
		entry relMove ( checkpoints [ count ] )
	}
	state StartFrontReader {
		entry reading = BarCodeReaderStart ( )
	}
	state MoveToCheckpoints {
		entry relMove ( checkpoints [ count ] )
	}
	state Abort {
	}
	final f0
	transition t0 {
		from i0
		to GoToShelf
	}
	transition t1 {
		from GoToShelf
		to StartFrontReader
	}
	transition t2 {
		from StartFrontReader
		to MoveToCheckpoints
		condition reading
		action count = 1
	}
	transition t3 {
		from StartFrontReader
		to Abort
		condition not reading
	}
	transition t4 {
		from Abort
		to f0
	}
	transition t5 {
		from MoveToCheckpoints
		to MoveToCheckpoints
		condition count < 8
		action count = count + 1
	}
	transition t6 {
		from MoveToCheckpoints
		to f0
		condition count >= 8
		action reading = BarCodeReaderStop ( )
	}
}

function len ( bases : vector ( Target , 6 ) ) : int { }  function calcDist( dronePos : Position , basePos : Position ) : real { } function tryToConnect ( ) : boolean { } function setHome ( ) : Position { } function SearchNearestBase ( img : Image ) : Position { } function SearchBases ( img : Image ) : vector ( Target , 6 ) { } function updateDronePos ( ) : Position { } function markVisitedBase ( pos : Position , bases : vector ( Target , 6 ) ) : vector ( Target , 6 ) { } function BarCodeReaderStart ( ) : boolean { } function BarCodeReaderStop ( ) : boolean { } function optimizeBasePositions ( ) : vector ( Target , 6 ) { } function isSafeToLand ( ) : boolean { }